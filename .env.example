# 铁道供电作业视频智能评价平台 —— 环境配置模板
#
# 复制为 .env 并填写，然后 **chmod 600 .env**。
# 这个文件同时存放 VLM API Key 和管理员引导口令，
# 权限放开等于把 AI 账号的消费能力和后台入口一起交出去。

# ---------------------------------------------------------------------------
# 必填
# ---------------------------------------------------------------------------

# 通义千问-VL（阿里云百炼）的 API Key。
# 申请后请在百炼控制台设置**消费告警**——这是 key 泄露时唯一的兜底。
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 首次启动时引导创建的管理员账号。
# 创建完成后**建议把 ADMIN_PASSWORD 从 .env 里删掉**：
# 它是明文口令，留在磁盘上只增加泄露面，而账号已经建好了。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe-Admin-2026

# AI 提供方。三选一：
#   vlm  —— 真实调用通义千问-VL。**生产必须用这个。**
#   demo —— 固定样本，不对视频内容做任何判断。界面上会打红色横幅。
#   fake —— 只有测试用，结果由文件名决定。
#
# 默认值是 vlm 而不是 demo，这是刻意的：配置漏了的时候必须报错，
# 而不是用假数据跑出一个漂亮的报告——那正是这个项目要修的病根。
AI_PROVIDER=vlm

# 模型名。留空则用代码里的默认值（qwen3-vl-plus）。
# 换模型前先跑 scripts/vlm_probe.py 看一致率，不要直接改这里上线。
VLM_MODEL=

# ---------------------------------------------------------------------------
# 部署相关
# ---------------------------------------------------------------------------

# 数据目录。**不要放在 NFS/网络盘上**：
# SQLite 的 WAL 依赖共享内存，网络文件系统上会静默损坏数据库。
DATA_DIR=/opt/railway-power/data

# 明文 HTTP 内网部署必须为 false，否则浏览器根本不会保存 cookie，
# 症状是"登录成功但一直未登录"。上了 HTTPS 再改成 true。
COOKIE_SECURE=false

# 会话有效期（小时）。一节课 2 小时，取 12 小时能覆盖整个上午的实训。
SESSION_TTL_HOURS=12

# cookie 名。**必须全局唯一**：同一台机器上跑着十几个项目，
# cookie 的作用域是 host 而不是 host:port，重名会互相覆盖导致随机掉登录。
COOKIE_NAME=rpo_session

# ---------------------------------------------------------------------------
# 限额
# ---------------------------------------------------------------------------

# 单个视频大小上限（字节）。默认 2GB。
MAX_UPLOAD_BYTES=2147483648

# 时长上下限（秒）。上限比任何优化都省钱：
# 实训视频 3-10 分钟，超过 15 分钟必然是误传，直接拒绝能省一整轮 API 调用。
MAX_DURATION_SEC=900

# 下限**不要低于 20**：抽帧按 5 秒间隔去重，而分析至少要 4 帧，
# 实测 20 秒才刚好抽到 4 帧（5 秒→1 帧，15 秒→3 帧）。
# 调到 20 以下，学生就会经历"上传成功 → 排队 → 才告诉你看不清"。
MIN_DURATION_SEC=20

# 每天最多调用多少次 VLM。防的是失控放大：
# 一次配错参数、或者有人"批量重跑全库"，能在一夜之间烧掉几百块。
# 超限后新任务直接失败并给出中文原因，而不是继续烧钱。
# 按 100 学生 × 3 次作业 ≈ 300 个视频、每视频 4 次调用，2000 是充裕的。
DAILY_CALL_BUDGET=2000

# ---------------------------------------------------------------------------
# 可选
# ---------------------------------------------------------------------------

# ffmpeg/ffprobe 不在 PATH 里时用绝对路径指定。
# 静态构建（无需 root）的典型场景。
# FFMPEG_BIN=/opt/ffmpeg/bin/ffmpeg
# FFPROBE_BIN=/opt/ffmpeg/bin/ffprobe
